# ---------------------------------------------------------------
# SoulPath Holiday — environment
# Copy to .env.local (never commit .env.local)
# ---------------------------------------------------------------

# Base URL of the EXISTING SoulPath backend (unchanged endpoints)
NEXT_PUBLIC_API_BASE=https://royalblue-giraffe-182996.hostingersite.com/api

# Origin that serves /uploads and /videos media (same host as the API by default)
NEXT_PUBLIC_MEDIA_ORIGIN=https://royalblue-giraffe-182996.hostingersite.com

# Origin that serves the original hero video (/videos/hero-banner-soulpath.mp4).
# Kept on the existing site origin so the original asset keeps loading.
NEXT_PUBLIC_SITE_ORIGIN=https://soulpathholiday.com

# Canonical public URL of the redesigned site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback WhatsApp number if site-settings cannot be reached
NEXT_PUBLIC_WHATSAPP_FALLBACK=919898211063
